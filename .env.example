# Get this from console.groq.com to use the DeepSeek-R1 model
GROQ_API_KEY="API KEY HERE"

# Path to your Firebase service account JSON file, downloaded from Firebase Console
FIREBASE_CREDENTIALS_PATH=your_key_here

# API key for IP lookup service (e.g., ip-api.com, ipinfo.io)
IP_API_KEY=

# The LLM model to be used by Groq API
GROQ_MODEL_NAME=deepseek-r1-distill-llama-70b

# Minimum number of reports before a QR payload is added to the global blacklist
BLACKLIST_MIN_REPORTS=3

# Number of days a blacklisted payload remains active in the database before expiry
BLACKLIST_TTL_DAYS=90

# Maximum Levenshtein distance to a legitimate domain to be considered a typosquatting attack
TYPOSQUAT_MAX_DISTANCE=2

# Number of days after domain registration before it is considered generally safe
DOMAIN_SAFE_AGE_DAYS=730

# Domains younger than these many days are flagged as highly suspicious
DOMAIN_DANGER_AGE_DAYS=7

# Maximum tokens the LLM is allowed to generate in a single reasoning response
LLM_MAX_TOKENS=1000

# Cache time-to-live in seconds to prevent repeated expensive OSINT network calls
CACHE_TTL_SECONDS=3600
